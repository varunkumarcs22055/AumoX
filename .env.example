# Resend (https://resend.com) — for sending contact form emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions land
CONTACT_EMAIL_TO=hello@aumoxo.tech
CONTACT_EMAIL_FROM=onboarding@resend.dev

# Public site URL (used for meta tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin console password (gates /admin/*)
# Defaults to "aumox-admin" if unset — change in production.
ADMIN_PASSWORD=aumox-admin
